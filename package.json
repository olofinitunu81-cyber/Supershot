{
  "name": "supershot",
  "version": "1.0.0",
  "private": true,
  "description": "SUPERSHOT — a fast, stylish multiplayer first-person shooter for the browser.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node scripts/dev.mjs",
    "test": "node --no-warnings=ExperimentalWarning --test tests/*.test.js",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fontsource/russo-one": "5.3.0",
    "@fontsource/saira": "5.3.0",
    "@fontsource/teko": "5.3.0",
    "@preact/signals": "2.11.4",
    "esbuild": "0.28.2",
    "preact": "10.29.8",
    "three": "0.187.0"
  }
}
